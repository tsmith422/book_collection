<p style="color: green"><%= notice %></p>

<h1>User books</h1>
<h3>This is the authenticated version 2</h3>

<h3>You are logged in! Welcome to the Dashboard!</h3>
<%= link_to "Sign Out", destroy_admin_session_path %>

<table>
  <thead>
    <tr>
      <th>Username</th>
      <th>Book Title</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @user_books.each do |user_book| %>
      <tr>
        <td><%= User.where(id: user_book.user_id).last.username %></td>
        <td><%= Book.where(id: user_book.book_id).last.title %></td>
        <td><%= link_to "Show", user_book %></td>
        <td><%= link_to "Edit", edit_user_book_path(user_book) %></td>
        <td><%= link_to "Destroy", user_book, method: :delete, data: { confirm: "Are you sure?" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to "New user book", new_user_book_path %>

<br>

<%= link_to 'Book index', books_path %>

<br>

<%= link_to 'User index', users_path %>
